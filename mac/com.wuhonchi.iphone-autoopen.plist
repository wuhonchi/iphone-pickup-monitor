<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: cp mac/com.wuhonchi.iphone-autoopen.plist ~/Library/LaunchAgents/ &&
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wuhonchi.iphone-autoopen.plist -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wuhonchi.iphone-autoopen</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-u</string>
		<string>/Users/wuhonchi/Documents/iphone/mac/autoopen.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/wuhonchi/Documents/iphone/mac/autoopen.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/wuhonchi/Documents/iphone/mac/autoopen.log</string>
</dict>
</plist>
