<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: see mac/install.sh (copies autoopen.py + a topic-only .env to ~/Library/Application Support/iphone-autoopen,
     since launchd jobs cannot read ~/Documents). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wuhonchi.iphone-autoopen</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-u</string>
		<string>/Users/wuhonchi/Library/Application Support/iphone-autoopen/autoopen.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/wuhonchi/Library/Application Support/iphone-autoopen/autoopen.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/wuhonchi/Library/Application Support/iphone-autoopen/autoopen.log</string>
</dict>
</plist>
